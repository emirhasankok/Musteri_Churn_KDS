@model IEnumerable<Churn.Models.Musteriler>

@{
    ViewData["Title"] = "Müşteri Listesi";
}

<h1>Müşteri Listesi</h1>
<p>
    <a asp-action="Create">Yeni Müşteri Ekle</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Yaş</th>
            <th>Kaç Aydır Müşteri</th>
            <th>Aylık Harcama (TL)</th>
            <th>Destek Talebi Sayısı</th>
            <th>Sisteme Son Giriş (Gün)</th>
            <th>Kayıp Durumu (Churn)</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Yas)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.KullanimSuresiAy)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AylikHarcamaTl)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DestekTalebiSayisi)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SonGirisGunu)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChurnDurumu)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MusteriId">Güncelle</a> |
                    <a asp-action="Details" asp-route-id="@item.MusteriId">Detaylar</a> |
                    <a asp-action="Delete" asp-route-id="@item.MusteriId">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>